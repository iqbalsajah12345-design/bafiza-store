
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BAFIZA | Look Good. Feel Confident.</title>
<meta name="description" content="BAFIZA - Modern fashion for men and women. Look Good. Feel Confident.">

<style>
:root {
  --black:#171717;
  --beige:#e9dfcf;
  --cream:#f8f6f1;
  --white:#fff;
}
* { box-sizing:border-box; margin:0; padding:0; }
body {
  font-family:Arial, sans-serif;
  background:var(--cream);
  color:var(--black);
}
header {
  background:var(--black);
  color:white;
  padding:19px 5%;
  display:flex;
  align-items:center;
  justify-content:space-between;
  position:sticky;
  top:0;
  z-index:10;
}
.logo { font-size:25px; letter-spacing:5px; font-weight:bold; }
.cart-button {
  background:var(--beige);
  color:var(--black);
  border:0;
  border-radius:4px;
  padding:10px 14px;
  font-weight:bold;
}
.hero {
  min-height:390px;
  background:linear-gradient(90deg,rgba(0,0,0,.78),rgba(0,0,0,.15)),
  url('https://images.unsplash.com/photo-1483985988355-763728e1935b?w=1400') center/cover;
  color:white;
  display:flex;
  flex-direction:column;
  justify-content:center;
  padding:55px 8%;
}
.hero small { letter-spacing:4px; color:var(--beige); }
.hero h1 { font-size:clamp(38px,8vw,65px); margin:15px 0; }
.hero p { max-width:430px; line-height:1.7; }
.hero a {
  display:inline-block;
  width:max-content;
  margin-top:25px;
  padding:13px 24px;
  background:var(--beige);
  color:var(--black);
  text-decoration:none;
  font-weight:bold;
}
section { padding:45px 5%; }
.section-title { text-align:center; margin-bottom:25px; }
.section-title h2 { font-size:28px; letter-spacing:2px; }
.section-title p { margin-top:8px; color:#777; }
.filters {
  display:flex;
  gap:9px;
  justify-content:center;
  flex-wrap:wrap;
  margin-bottom:28px;
}
.filters button {
  border:1px solid #aaa;
  background:transparent;
  padding:10px 17px;
  border-radius:25px;
}
.filters button.active {
  background:var(--black);
  color:white;
}
.products {
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:15px;
  max-width:1050px;
  margin:auto;
}
.product {
  background:white;
  padding-bottom:15px;
  overflow:hidden;
}
.product img {
  width:100%;
  aspect-ratio:4/5;
  object-fit:cover;
  display:block;
  background:#e5e0d8;
}
.product-info { padding:13px; }
.product-info h3 { font-size:15px; margin-bottom:7px; }
.price { font-weight:bold; margin-bottom:12px; }
.product button {
  width:100%;
  padding:11px;
  border:0;
  background:var(--black);
  color:white;
  font-weight:bold;
}
.about {
  background:var(--beige);
  text-align:center;
  line-height:1.8;
}
.about p { max-width:600px; margin:12px auto 0; }
footer {
  background:var(--black);
  color:white;
  text-align:center;
  padding:30px 15px;
  line-height:2;
}
footer a { color:var(--beige); }
#cart {
  background:white;
  max-width:700px;
  margin:20px auto;
  padding:20px;
  display:none;
}
#cart h2 { margin-bottom:15px; }
.cart-line {
  display:flex;
  justify-content:space-between;
  gap:10px;
  padding:10px 0;
  border-bottom:1px solid #ddd;
}
.checkout {
  width:100%;
  margin-top:15px;
  padding:14px;
  background:#222;
  color:white;
  border:0;
  font-weight:bold;
}
@media(min-width:700px) {
  .products { grid-template-columns:repeat(4,minmax(0,1fr)); gap:22px; }
}
</style>
</head>

<body>

<header>
  <div class="logo">BAFIZA</div>
  <button class="cart-button" onclick="toggleCart()">
    BAG (<span id="cart-count">0</span>)
  </button>
</header>

<div class="hero">
  <small>NEW FASHION COLLECTION</small>
  <h1>LOOK GOOD.<br>FEEL CONFIDENT.</h1>
  <p>Discover your style. Find your confidence. Explore modern fashion for every day.</p>
  <a href="#shop">EXPLORE COLLECTION</a>
</div>

<section id="shop">
  <div class="section-title">
    <h2>OUR COLLECTION</h2>
    <p>Find your style with BAFIZA</p>
  </div>

  <div class="filters">
    <button class="active" onclick="filterProducts('all',this)">All</button>
    <button onclick="filterProducts('men',this)">Men</button>
    <button onclick="filterProducts('women',this)">Women</button>
    <button onclick="filterProducts('shoes',this)">Shoes</button>
  </div>

  <div class="products" id="products"></div>

  <div id="cart">
    <h2>Your Shopping Bag</h2>
    <div id="cart-items"></div>
    <h3 id="cart-total" style="margin-top:15px">Total: Rp0</h3>
    <button class="checkout" onclick="checkout()">ORDER VIA WHATSAPP</button>
  </div>
</section>

<section class="about">
  <h2>ABOUT BAFIZA</h2>
  <p>BAFIZA is a modern fashion brand for men and women. We believe that great style brings confidence. Express yourself and feel confident every day.</p>
  <p><strong>LOOK GOOD. FEEL CONFIDENT.</strong></p>
</section>

<footer>
  <h2 style="letter-spacing:5px">BAFIZA</h2>
  <p>LOOK GOOD. FEEL CONFIDENT.</p>
  <p>Customer Service</p>
  <a href="https://wa.me/6283822230126" target="_blank">Contact us on WhatsApp</a>
  <p>© 2026 BAFIZA. All rights reserved.</p>
</footer>

<script>
const products = [
  {
    id:1, name:"Oversized Tee", category:"men",
    price:99000,
    image:"https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?w=600"
  },
  {
    id:2, name:"Daily Blouse", category:"women",
    price:119000,
    image:"https://images.unsplash.com/photo-1483985988355-763728e1935b?w=600"
  },
  {
    id:3, name:"Straight Pants", category:"men",
    price:149000,
    image:"https://images.unsplash.com/photo-1473966968600-fa801b869a1a?w=600"
  },
  {
    id:4, name:"Wide Pants", category:"women",
    price:139000,
    image:"https://images.unsplash.com/photo-1509631179647-0177331693ae?w=600"
  },
  {
    id:5, name:"Daily Sneakers", category:"shoes",
    price:199000,
    image:"https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=600"
  }
];

let cart = [];
let currentFilter = "all";

function rupiah(value) {
  return "Rp" + value.toLocaleString("id-ID");
}

function showProducts() {
  const area = document.getElementById("products");
  const filtered = products.filter(p =>
    currentFilter === "all" || p.category === currentFilter
  );

  area.innerHTML = filtered.map(p => `
    <div class="product">
      <img src="${p.image}" alt="${p.name}" loading="lazy">
      <div class="product-info">
        <h3>${p.name}</h3>
        <div class="price">${rupiah(p.price)}</div>
        <button onclick="addToCart(${p.id})">ADD TO BAG</button>
      </div>
    </div>
  `).join("");
}

function filterProducts(category,button) {
  currentFilter = category;
  document.querySelectorAll(".filters button").forEach(b =>
    b.classList.remove("active")
  );
  button.classList.add("active");
  showProducts();
}

function addToCart(id) {
  const product = products.find(p => p.id === id);
  const existing = cart.find(p => p.id === id);

  if(existing) existing.qty++;
  else cart.push({...product,qty:1});

  updateCart();
}

function updateCart() {
  const count = cart.reduce((sum,p) => sum + p.qty,0);
  const total = cart.reduce((sum,p) => sum + p.price*p.qty,0);

  document.getElementById("cart-count").textContent = count;
  document.getElementById("cart-items").innerHTML =
    cart.length ? cart.map(p => `
      <div class="cart-line">
        <span>${p.name} × ${p.qty}</span>
        <span>${rupiah(p.price*p.qty)}</span>
      </div>
    `).join("") : "<p>Your bag is empty.</p>";

  document.getElementById("cart-total").textContent =
    "Total: " + rupiah(total);
}

function toggleCart() {
  const cartBox = document.getElementById("cart");
  cartBox.style.display =
    cartBox.style.display === "block" ? "none" : "block";
  updateCart();
  cartBox.scrollIntoView({behavior:"smooth"});
}

function checkout() {
  if(cart.length === 0) {
    alert("Keranjang masih kosong.");
    return;
  }

  let message = "Halo BAFIZA, saya ingin memesan:%0A";
  cart.forEach(p => {
    message += "%0A- " + p.name + " x" + p.qty +
      " = " + rupiah(p.price*p.qty);
  });

  const total = cart.reduce((sum,p) => sum+p.price*p.qty,0);
  message += "%0A%0ATotal: " + rupiah(total);
  message += "%0A%0AMohon informasi cara pemesanan. Terima kasih.";

  window.open("https://wa.me/6283822230126?text=" +
    encodeURIComponent(decodeURIComponent(message)), "_blank");
}

showProducts();
updateCart();
</script>

</body>
</html>
